    def _scan_thread(self):
        """Scan thread - gets FULL BSSID"""
        try:
            result = subprocess.run(
                "netsh wlan show networks mode=bssid",
                shell=True, capture_output=True, text=True
            )
            
            networks_data = []
            current = {}
            
            for line in result.stdout.split('\n'):
                line = line.strip()
                
                if 'SSID' in line and ':' in line and 'BSSID' not in line:
                    if current:
                        networks_data.append(current)
                    current = {'ssid': line.split(':', 1)[1].strip()}
                elif 'BSSID' in line and ':' in line and 'Signal' not in line:
                    # Extract full BSSID (everything after colon)
                    current['bssid'] = line.split(':', 1)[1].strip()
                elif 'Signal' in line and ':' in line:
                    current['signal'] = line.split(':', 1)[1].strip()
                elif 'Authentication' in line and ':' in line:
                    current['auth'] = line.split(':', 1)[1].strip()
            
            if current:
                networks_data.append(current)
            
            for network in networks_data:
                self.output_queue.put(('network', network))
            
            self.output_queue.put(('log', f"📡 Found {len(networks_data)} networks", 'success'))
            
        except Exception as e:
            self.output_queue.put(('log', f"❌ {e}", 'error'))
        finally:
            self.output_queue.put(('done', None))
        
