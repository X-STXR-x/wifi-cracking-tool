    def process_queue(self):
        """Process queue"""
        try:
            while True:
                item = self.output_queue.get_nowait()
                
                if item[0] == 'log':
                    self.log(item[1], item[2])
                elif item[0] == 'network':
                    network = item[1]
                    self.networks_tree.insert('', 'end', values=(
                        network.get('ssid', 'N/A'),
                        network.get('bssid', 'N/A'),
                        network.get('signal', 'N/A'),
                        network.get('auth', 'N/A')
                    ))
                elif item[0] == 'password':
                    profile, password = item[1]
                    self.passwords_tree.insert('', 'end', values=(profile, password))
                elif item[0] == 'brute_progress':
                    progress, speed = item[1]
                    self.brute_progress_var.set(progress)
                    self.brute_progress_label.config(text=f"{progress:.1f}%")
                elif item[0] == 'brute_done':
                    self.brute_force_button.config(state='normal')
                    self.stop_brute_button.config(state='disabled')
                    if self.password_found:
                        self.brute_status_label.config(text="✅ FOUND!", fg='#00ff00')
                    elif self.stop_flag.is_set():
                        self.brute_status_label.config(text="⏹ STOPPED", fg='#ff0000')
                    else:
                        self.brute_status_label.config(text="❌ NOT FOUND", fg='#ff0000')
                elif item[0] == 'deauth_counter':
                    self.deauth_counter_label.config(text=f"Packets: {item[1]}")
                elif item[0] == 'deauth_done':
                    self.deauth_button.config(state='normal')
                    self.stop_deauth_button.config(state='disabled')
                    self.deauth_status_label.config(text="✅ COMPLETED", fg='#00ff00')
                elif item[0] == 'done':
                    self.running = False
                    
        except queue.Empty:
            pass
        
        self.root.after(50, self.process_queue)
        
