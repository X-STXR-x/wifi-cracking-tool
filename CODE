class EgyptianPasswordGenerator:
    """Generate common password patterns"""
    
    def __init__(self):
        self.names = [
            "ahmed", "mohamed", "mahmoud", "mostafa", "youssef", "omar", "ali",
            "khaled", "hassan", "hussien", "ibrahim", "tarek", "sherif", "amr",
            "karim", "hany", "waleed", "samy", "adel", "magdy", "ashraf", "ayman",
            "essam", "hossam", "islam", "maged", "mina", "nabil",
            "osama", "ramy", "salah", "sameh", "sayed", "wael", "yasser",
            "hamada", "abdo", "shady", "fady", "bassem", "hazem",
            "sara", "salma", "nour", "dina", "heba", "rana", "yara", "farah",
            "malak", "habiba", "menna", "nada", "reem", "shahd", "yasmin",
            "jana", "layla", "mariam", "nouran", "radwa", "shaimaa",
            "john", "mike", "david", "chris", "alex", "james", "robert",
            "michael", "william", "daniel", "joseph", "thomas", "charles",
            "mary", "jennifer", "linda", "patricia", "elizabeth", "susan",
            "jessica", "sarah", "karen", "nancy", "lisa", "betty"
        ]
        
        self.years = [str(y) for y in range(1970, 2031)]
        self.symbols = ["@", "#", "$", "!", "*", "_", ".", "-"]
        
    def generate_common_passwords(self, count=100):
        passwords = set()
        
        patterns = [
            "{name}{year}", "{name}@{year}", "{name}{number}", "{name}@{number}",
            "{name}_{year}", "{name}.{year}", "{name}{symbol}{number}",
            "{cap}{year}", "{cap}@{year}", "{name}{phone}", "{name}@{phone}",
            "{name}{year}!", "{name}@{year}!", "{name}123", "{name}@123",
            "{name}2020", "{name}@2020", "{name}2024", "{name}@2024",
            "{name}2030", "{name}@2030"
        ]
        
        common = [
            "12345678", "password", "123456789", "1234567890",
            "qwerty123", "admin123", "wifi123", "1234567",
            "iloveyou", "00000000", "123123", "abc123",
            "11111111", "password1", "123456", "qwerty",
            "welcome", "login", "admin", "letmein"
        ]
        passwords.update(common)
        
        while len(passwords) < count:
            name = random.choice(self.names)
            pattern = random.choice(patterns)
            
            password = pattern
            password = password.replace("{name}", name)
            password = password.replace("{cap}", name.capitalize())
            password = password.replace("{year}", random.choice(self.years))
            password = password.replace("{number}", str(random.randint(1, 9999)))
            password = password.replace("{symbol}", random.choice(self.symbols))
            
            if "{phone}" in password:
                phone = random.choice(["010", "011", "012", "015"]) + ''.join(random.choice(string.digits) for _ in range(8))
                password = password.replace("{phone}", phone)
            
            passwords.add(password)
        
        return list(passwords)
    
    def generate_phone_passwords(self, count=50):
        passwords = set()
        prefixes = ["010", "011", "012", "015"]
        
        while len(passwords) < count:
            phone = random.choice(prefixes) + ''.join(random.choice(string.digits) for _ in range(8))
            variations = [phone, f"0{phone}", f"{phone}@", f"0{phone}@", f"{phone}!", f"0{phone}!"]
            passwords.add(random.choice(variations))
        
        return list(passwords)
    
    def generate_name_passwords(self, count=100):
        passwords = set()
        
        while len(passwords) < count:
            name = random.choice(self.names)
            year = random.choice(self.years)
            symbol = random.choice(self.symbols)
            number = str(random.randint(1, 9999))
            
            variations = [
                name, name.capitalize(), name.upper(),
                name + year, name + "@" + year, name + symbol + year,
                name.capitalize() + year, name.capitalize() + "@" + year,
                name + number, name + "@" + number, name + symbol + number,
                name + year + "!", name + "@" + year + "!",
                name + "123", name + "@123", name + "2020", name + "@2020",
                name + "2024", name + "@2024", name + "2030", name + "@2030"
            ]
            
            passwords.add(random.choice(variations))
        
        return list(passwords)
    
    def generate_all(self, count=200):
        passwords = set()
        passwords.update(self.generate_common_passwords(count // 2))
        passwords.update(self.generate_phone_passwords(count // 4))
        passwords.update(self.generate_name_passwords(count // 4))
        return list(passwords)

