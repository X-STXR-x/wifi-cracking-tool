    def _extract_thread(self):
        """Extract thread"""
        try:
            result = subprocess.run(
                "netsh wlan show profiles",
                shell=True, capture_output=True, text=True
            )
            
            profiles = re.findall(r'All User Profile\s+: (.+)', result.stdout)
            
            for profile in profiles:
                profile = profile.strip()
                result2 = subprocess.run(
                    f'netsh wlan show profile "{profile}" key=clear',
                    shell=True, capture_output=True, text=True
                )
                
                password_match = re.search(r'Key Content\s+: (.+)', result2.stdout)
                password = password_match.group(1).strip() if password_match else 'None'
                
                self.output_queue.put(('password', (profile, password)))
                
            self.output_queue.put(('log', f"🔑 Extracted {len(profiles)} profiles", 'success'))
            
        except Exception as e:
            self.output_queue.put(('log', f"❌ {e}", 'error'))
        finally:
            self.output_queue.put(('done', None))
            
    def connect_to_wifi(self):
        """Connect to WiFi"""
        ssid = self.ssid_entry.get().strip()
        password = self.password_entry.get().strip()
        
        if not ssid:
            messagebox.showerror("Error", "Enter network name")
            return
        
        self.log(f"🔗 Connecting to {ssid}...", 'info')
        threading.Thread(target=self._connect_thread, args=(ssid, password), daemon=True).start()
        
    def _connect_thread(self, ssid, password):
        """Connect thread"""
        try:
            if password:
                profile_xml = f'''<?xml version="1.0"?>
<WLANProfile xmlns="http://www.microsoft.com/networking/WLAN/profile/v1">
    <name>{ssid}</name>
    <SSIDConfig>
        <SSID>
            <name>{ssid}</name>
        </SSID>
    </SSIDConfig>
    <connectionType>ESS</connectionType>
    <connectionMode>auto</connectionMode>
    <MSM>
        <security>
            <authEncryption>
                <authentication>WPA2PSK</authentication>
                <encryption>AES</encryption>
                <useOneX>false</useOneX>
            </authEncryption>
            <sharedKey>
                <keyType>passPhrase</keyType>
                <protected>false</protected>
                <keyMaterial>{password}</keyMaterial>
            </sharedKey>
        </security>
    </MSM>
</WLANProfile>'''
                
                with open(f"{ssid}_profile.xml", "w") as f:
                    f.write(profile_xml)
                
                subprocess.run(
                    f'netsh wlan add profile filename="{ssid}_profile.xml"',
                    shell=True, capture_output=True
                )
                
                os.remove(f"{ssid}_profile.xml")
            
            result = subprocess.run(
                f'netsh wlan connect name="{ssid}"',
                shell=True, capture_output=True, text=True
            )
            
            if "completed successfully" in result.stdout.lower():
                self.output_queue.put(('log', f"✅ Connected to {ssid}", 'success'))
            else:
                self.output_queue.put(('log', "❌ Connection failed", 'error'))
                
        except Exception as e:
            self.output_queue.put(('log', f"❌ {e}", 'error'))
        finally:
            self.output_queue.put(('done', None))
            
    def disconnect_wifi(self):
        """Disconnect"""
        self.log("🔌 Disconnecting...", 'info')
        subprocess.run("netsh wlan disconnect", shell=True, capture_output=True)
        self.log("✅ Disconnected", 'success')

def main():
    root = tk.Tk()
    app = WiFiToolGUI(root)
    
    def on_closing():
        if app.brute_force_active or app.deauth_active:
            if messagebox.askyesno("Attack Running", "Stop and exit?"):
                app.stop_brute_force()
                if app.deauth_active:
                    app.stop_deauth()
                root.destroy()
        else:
            root.destroy()
    
    root.protocol("WM_DELETE_WINDOW", on_closing)
    root.mainloop()

if __name__ == "__main__":
    main()
